# Database
DATABASE_URL=sqlite:///./medikiosk.db
# For PostgreSQL: postgresql://user:password@localhost:5432/medikiosk

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=43200

# Environment
ENVIRONMENT=development

# Speech Recognition
SPEECH_PROVIDER=mock
# Options: mock, sarvam
SARVAM_API_KEY=sk_w3qlqldm_lB4k8Joen9J9jfOp7c5Odout

# Text-to-Speech
TTS_PROVIDER=mock
# Options: mock, sarvam

# OCR
OCR_PROVIDER=mock
# Options: mock, tesseract, vision
VISION_API_KEY=

# ABHA / ABDM
ABHA_PROVIDER=mock
ABDM_PROVIDER=mock
# Options: mock, production

# Queue
QUEUE_PROVIDER=mock

# API Configuration
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/jpg","application/pdf"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
